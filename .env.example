# Orbit FC — environment template. Copy to .env.local and fill in. NEVER commit .env*.
# The app runs fully on the in-memory store with NONE of these set; add them to
# bring the real backend online. See BACKEND.md.

# ── Supabase (the backend: Postgres + Auth + Storage) ──
# Project Settings → API. The anon key is safe in the client (RLS enforces access).
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=


# ── LLM layer (AI triage / patterns / vendor match) ──
# When ANTHROPIC_API_KEY is set, the server-side AI service calls Claude;
# otherwise it returns the deterministic heuristic (UI shows which).
ANTHROPIC_API_KEY=
# Model — defaults to claude-opus-4-8. Set claude-sonnet-4-6 for cheaper/faster triage.
ORBIT_AI_MODEL=claude-opus-4-8

# ── Database (Drizzle / Postgres) — backend phase ──
DATABASE_URL=

# ── Auth (Argon2 + session/JWT) — backend phase ──
AUTH_SECRET=
