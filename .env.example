# Orbit FC — environment template. Copy to .env and fill in for backend/AI work.
# The frontend slice runs with seed data and the AI layer falls back to a
# deterministic heuristic, so none of these are required to demo the app.

# ── LLM layer (AI triage / patterns / vendor match) ──
# When ANTHROPIC_API_KEY is set, the server-side AI service calls Claude;
# otherwise it returns the deterministic heuristic (UI shows which).
ANTHROPIC_API_KEY=
# Model — defaults to claude-opus-4-8. Set claude-sonnet-4-6 for cheaper/faster triage.
ORBIT_AI_MODEL=claude-opus-4-8

# ── Database (Drizzle / Postgres) — backend phase ──
DATABASE_URL=

# ── Auth (Argon2 + session/JWT) — backend phase ──
AUTH_SECRET=
