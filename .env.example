# Orbit FC — environment template. Copy to .env and fill in for backend/AI work.
# (The current frontend slice runs with seed data and needs none of these.)

# ── LLM layer (AI Review / triage) — defaults to Anthropic Claude ──
ANTHROPIC_API_KEY=
# Model ids: claude-opus-4-8 (deep), claude-sonnet-4-6 (cheaper/faster triage)
ORBIT_AI_MODEL=claude-sonnet-4-6

# ── Database (Drizzle / Postgres) — backend phase ──
DATABASE_URL=

# ── Auth (Argon2 + session/JWT) — backend phase ──
AUTH_SECRET=
